@model List<DeviceTypeViewModel>

@{
    ViewData["Title"] = "Типы техники";
    string? name = ViewBag.Name as string;
}

<h2 class="mb-3">Типы техники</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input type="text" name="name" value="@name" class="form-control" placeholder="Поиск по названию" />
    </div>

    <div class="col-12 col-md-6">
        <button type="submit" class="btn btn-primary">Найти</button>
        <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        <a asp-action="Create" class="btn btn-success">Добавить</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Название</th>
                <th>Описание</th>
                <th style="width: 220px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center">Типы техники не найдены</td>
                </tr>
            }
            else
            {
                foreach (var deviceType in Model)
                {
                    <tr>
                        <td>@deviceType.Name</td>
                        <td>@deviceType.Description</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@deviceType.Id" class="btn btn-sm btn-warning">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@deviceType.Id" class="btn btn-sm btn-danger">Удалить</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>